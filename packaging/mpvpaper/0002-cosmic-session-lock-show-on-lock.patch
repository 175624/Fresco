# Patch: opt-in lock-screen wallpaper via cosmic-comp's session-lock-layer
#
# COSMIC (cosmic-comp, merged 2026-09-11 in pop-os/cosmic-comp#2792) exposes a
# global `cosmic_session_lock_layer_manager_v1` (protocol
# `cosmic-session-lock-layer-v1`, from pop-os/cosmic-protocols, vendored here
# as proto/cosmic-session-lock-layer-v1.xml — MIT-licensed, see the
# <copyright> block in that file; compatible with mpvpaper's GPL-3.0). Any
# non-sandboxed client may call set_show_on_lock(layer) on one of its own
# zwlr_layer_surface_v1 surfaces; cosmic-comp then keeps drawing that layer
# surface while the session is locked, instead of hiding it like every other
# non-lock surface. cosmic-bg (the reference client for this protocol) does
# exactly this for its own background layer surface.
#
# This patch teaches mpvpaper the same trick, entirely opt-in:
#
#   - MPVPAPER_SHOW_ON_LOCK is a new environment variable, read once at the
#     top of main() (getenv(), not a CLI flag). mpvpaper already parses
#     getopt_long() options, but every existing flag is either a boolean tied
#     to a single-letter short option or threads a value through
#     parse_command_line() into struct wl_state; wiring a new flag through
#     that path (long_options[], the getopt_long() switch, usage text, and
#     then back out to the two call sites below) touches far more of the file
#     than a single getenv() read does, for a switch Fresco itself will set on
#     the child process environment either way. An env var is the smaller
#     diff and matches existing precedent in this file (getenv("HOME") in
#     parse_command_line()).
#   - Unset, empty, or "0" means off; anything else means on. Off is
#     byte-for-byte the same behavior as unpatched mpvpaper — every change
#     below is inside an `if (show_on_lock_requested ...)` guard.
#   - The manager is only bound in handle_global() when the env var is set
#     (mirroring how this same function already gates the
#     zwlr_foreign_toplevel_manager_v1 bind behind
#     `halt_info.auto_pause > 1 || halt_info.auto_stop > 1` — conditionally
#     binding an optional global on whether its feature was requested is
#     already this file's own convention, not a new pattern). On any
#     compositor that doesn't advertise the interface at all (Sway, Hyprland,
#     KDE, older COSMIC), or when the env var isn't set, session_lock_layer_manager
#     simply stays NULL, exactly like today.
#   - set_show_on_lock() is sent for each output's layer surface from
#     create_layer_surface(), after the surface is created/configured and
#     before its first wl_surface_commit() — show-on-lock is double-buffered
#     on that commit per the protocol's own doc comment, same as the
#     anchor/exclusive-zone state already set a few lines above it. Every
#     output goes through this exact function and no other, whether it was
#     present at startup or plugged in later (handle_global() adds a
#     display_output and listens for wl_output's `done` event, which calls
#     create_layer_surface() the same way regardless of when the output
#     showed up) — so hotplugged outputs are covered for free, with no
#     separate hotplug-specific code path to keep in sync.
#   - If MPVPAPER_SHOW_ON_LOCK is set but the compositor never advertises the
#     manager, main() logs one line once, right after the same roundtrip that
#     already checks for the other required interfaces. It's written with a
#     bare fprintf(stderr, ...) rather than any cflp_* helper: every function
#     in cflogprinter.c (cflp_error/cflp_warning included, despite the names)
#     prints to stdout, and this diagnostic is required to land on stderr.
#   - The manager proxy is destroyed in exit_cleanup(), alongside the
#     existing (also best-effort — the process is exiting regardless) EGL and
#     mpv teardown calls it already makes there.
#
# The new protocol file is generated with wayland-scanner the same way as
# mpvpaper's two existing vendored protocols (proto/*.xml via the
# scanner_private_code / scanner_client_header generators in meson.build) —
# see the meson.build hunk below. Shipping the XML as a "new file" hunk
# inside this patch (rather than a file copied in by the build script) means
# every build path that applies patches via `git apply`/`patch` —
# scripts/build-mpvpaper.sh and install.sh's standalone curl|bash rebuild —
# recreates
# proto/cosmic-session-lock-layer-v1.xml automatically, with no separate
# "copy this file into the clone" step to keep in sync across those paths.
#
# Applied automatically by scripts/build-mpvpaper.sh (and every other site
# that builds mpvpaper from source) against the pinned upstream tag "1.9",
# immediately after 0001-egl-context-gl-compat-and-gles-fallback.patch. Must
# apply cleanly on top of that patch — do not reorder them.
--- a/meson.build
+++ b/meson.build
@@ -13,15 +13,21 @@ scanner=find_program('wayland-scanner')
 scanner_private_code=generator(scanner,output: '@BASENAME@-protocol.c',arguments: ['private-code','@INPUT@','@OUTPUT@'])
 scanner_client_header=generator(scanner,output: '@BASENAME@-client-protocol.h',arguments: ['client-header','@INPUT@','@OUTPUT@'])

+# cosmic-session-lock-layer-v1: optional, only used when MPVPAPER_SHOW_ON_LOCK
+# is set and the compositor advertises cosmic_session_lock_layer_manager_v1
+# (currently cosmic-comp). Generated unconditionally like the other vendored
+# protocols; binding it at runtime is what stays optional.
 protocols_src=[
   scanner_private_code.process('proto/wlr-layer-shell-unstable-v1.xml'),
   scanner_private_code.process('proto/wlr-foreign-toplevel-management-unstable-v1.xml'),
+  scanner_private_code.process('proto/cosmic-session-lock-layer-v1.xml'),
   scanner_private_code.process(wl_protocols.get_variable('pkgdatadir')+'/stable/xdg-shell/xdg-shell.xml')
 ]

 protocols_headers=[
   scanner_client_header.process('proto/wlr-layer-shell-unstable-v1.xml'),
-  scanner_client_header.process('proto/wlr-foreign-toplevel-management-unstable-v1.xml')
+  scanner_client_header.process('proto/wlr-foreign-toplevel-management-unstable-v1.xml'),
+  scanner_client_header.process('proto/cosmic-session-lock-layer-v1.xml')
 ]

 lib_protocols=static_library('protocols',protocols_src+protocols_headers,dependencies: wl_client)
diff --git a/proto/cosmic-session-lock-layer-v1.xml b/proto/cosmic-session-lock-layer-v1.xml
new file mode 100644
index 0000000..a320457
